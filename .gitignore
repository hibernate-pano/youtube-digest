# Secrets — your real keys live here, never commit them
config.js

# OS / editor cruft
.DS_Store

# Planning / intermediate files (kept local, not published)
architecture.excalidraw
explainer-video/

# The panel pictures the store listing is composited from. They are
# generated: `node scripts/panel-review.js --store` writes them and
# `node scripts/store-shots.js` pastes them into the listing.
.review-store/

# Tooling & agent workspaces
.agents/
.augment/
.claude/
skills/
skills-lock.json
.playwright-mcp/
node_modules/
dist/

# Python bytecode from the mutation scripts
__pycache__/
*.pyc

# Server secrets (GitHub OAuth client secret, JWT secret, Neon URL)
server/.dev.vars

# Local database backups (contain user data — never commit)
server/backups/

# Environment
.env
.env.*
*.pem
*.key

# Wrangler local dev state and bundle artifacts
server/.wrangler/
server/dist-worker/

# pnpm lockfile (project uses npm)
pnpm-lock.yaml
