# 仓库根目录的环境变量清单 —— 只列名字和用途，值留空。
#
# 用法：cp .env.example .env 然后填值。
# .env 已在 .gitignore 里，永远不要提交；本文件可以提交。
#
# 注意：服务端（Cloudflare Worker）自己的变量不走这个文件，
# 那是 server/.dev.vars，模板见 server/.dev.vars.example。

# --- 必填 ---

# Neon Postgres 连接串。
# 用于 server/scripts/backup.js 的备份命令，以及 server/SETUP.md 里的建表步骤。
#   export NEON_URL=$(grep '^NEON_URL=' .env | cut -d= -f2- | tr -d '"')
NEON_URL=

# --- 本地开发用 ---

# GitHub OAuth 应用的 client key。
# 说明：代码里目前没有读取 GITHUB_CLIENT_KEY 的地方（服务端读的是 wrangler
# 上的 GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET，见 server/SETUP.md）。
# 之所以留着，是因为它在你本机的 .env 里确实存在，删掉模板这一行会让照抄的人
# 以为这个变量可以不管 —— 留着只是记录现状，不代表它在起作用。
GITHUB_CLIENT_KEY=

# GitHub OAuth 应用的 client secret。
# 这是真凭据：只填进 .env，别贴进 issue、截图、聊天或提交记录。
GITHUB_CLIENT_SECRET=